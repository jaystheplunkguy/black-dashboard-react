```
  ChangeGuard AI - macros (default/macros.conf). Settings > Advanced search > Search macros.
```

``` macro: cg_src_pan ```
index=network-services-pop-pan-net-s sourcetype="pan:config"

``` macro: cg_src_ios ```
index=network-services-pop-net-s ("%SYS-5-CONFIG_I" OR "%PARSER-5-CFGLOG_LOGGEDCMD")

``` macro: cg_src_ftd ```
index=secops-nspfirewalls-net ("mojo_server.pl" OR "sfdccsm" OR "ActionQueueScrape.pl")

``` macro: cg_src_calm ```
index="cmart-db-app-n" REQUEST_STATE="*RT*"

``` macro: cg_itam_ci_extract ```
index="itam-ci-database-app-s" sourcetype="itam-ci-extract"

``` macro: cg_helix_change_info ```
index="itam-reporting-database-app-n" source="*Change_Information*"

``` macro: cg_helix_change_approvals ```
index="itam-reporting-database-app-n" source="*Change_Approvals*"

``` macro: cg_helix_change_ci ```
index="itam-reporting-database-app-n" source="*Change_CI_Assoc*"

``` macro: cg_helix_incidents ```
index="itam-reporting-database-app-n" source="*Incident_Data*"

``` macro: cg_helix_ci_rel ```
index="itam-ci-database-app-s" source="*Asset*Relationship*"

``` macro: cg_helix_table ```
case(like(source, "%Change_Information%"), "info", like(source, "%Change_Approvals%"), "approval", like(source, "%Change_CI_Assoc%"), "ci", true(), "other")

``` macro: cg_norm_host(1)   args: f ```
if(match(trim($f$), "^\d{1,3}(\.\d{1,3}){3}$"), trim($f$), lower(trim(mvindex(split(trim($f$), "."), 0))))

``` macro: cg_ha_peer(1)   args: d ```
case(match($d$, "01$"), replace($d$, "01$", "02"), match($d$, "02$"), replace($d$, "02$", "01"), true(), null())

``` macro: cg_is_panorama(1)   args: d ```
match($d$, "^nspvmp")

``` macro: cg_default_panorama ```
"nspvmp1822da01"

``` macro: cg_chg_ref_rex ```
"(?i)(?<chg_ref>\b(?:CRQ\d{6,12}|CHG\d{5,12}|CALM[-_]?\d{3,12})\b)"

``` macro: cg_rollback_regex ```
"(?i)\b(rollback|roll back|revert|load config|configure replace|undo)\b"

``` macro: cg_time(1)   args: f ```
if(match($f$, "^\d+(\.\d+)?$"), tonumber($f$), round(coalesce(strptime($f$, "%Y-%m-%d %H:%M:%S.%N"), strptime($f$, "%Y-%m-%d %H:%M:%S"), strptime($f$, "%m/%d/%Y %H:%M:%S")), 0))

``` macro: cg_enrich_user ```
eval user_short=replace(user, "@.*$", "")
    | lookup roboID.csv user AS user_short OUTPUTNEW description AS robo_description
    | lookup global_address_lookup uid AS user_short OUTPUTNEW firstName surname title AS user_title
    | eval is_automation=if(isnotnull(robo_description), 1, 0),
        user_display=coalesce(robo_description, if(isnotnull(surname), surname.", ".firstName, null()), user)
    | fields - firstName surname robo_description

``` macro: cg_ci_match(1)   args: d ```
lookup itam_ci_lookup CI AS $d$ OUTPUT CI_Name AS ci_name Name AS ci_product Category AS ci_category
    | eval ci_name=mvindex(ci_name, 0), ci_product=mvindex(ci_product, 0), ci_category=mvindex(ci_category, 0)

``` macro: cg_is_service_ci ```
match(lower(coalesce(Category, "")." ".coalesce(Type, "")), "service")

``` macro: cg_detect_enrich ```
eval device=`cg_norm_host(device)`, user=lower(trim(user))
    | eval device_role=case(platform!="paloalto", platform, `cg_is_panorama(device)`, "panorama", true(), "firewall"),
        event_kind=case(platform="paloalto" AND cmd="commit-all", "push",
                        platform="paloalto" AND match(cmd, "^commit"), "commit",
                        platform="paloalto", "edit",
                        platform="cisco_ios" AND cmd="cli", "edit", true(), "notice")
    | lookup cg_panorama_members firewall AS device OUTPUT panorama AS member_of
    | eval session_device=if(event_kind="push" AND device_role="firewall", coalesce(member_of, `cg_default_panorama`), device),
        detail=trim(if(platform="paloalto", coalesce(cmd, "")." ".coalesce(path, ""), coalesce(msg, cmd, "")).if(len(comment)>0, " [comment: ".comment."]", "")),
        detail_kind=case(platform="paloalto" AND event_kind="edit" AND len(path)>0, "config_path",
                         platform="cisco_ios" AND cmd="cli", "command", true(), "notice")
    | rex field=detail max_match=5 `cg_chg_ref_rex`
    | eval chg_refs=mvjoin(mvdedup(mvmap(chg_ref, upper(chg_ref))), " ")
    | `cg_enrich_user`
    | `cg_ci_match(device)`
    | table _time event_id platform device device_role session_device event_kind user user_display user_title is_automation src cmd path comment result detail detail_kind chg_refs ci_name ci_product ci_category

``` macro: cg_window_slack ```
1800

