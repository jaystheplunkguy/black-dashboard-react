4

``` macro: cg_w_approved ```
2

``` macro: cg_w_user ```
1

``` macro: cg_calm_approved(1)   args: s ```
match(upper(coalesce($s$, "")), "RT")

``` macro: cg_helix_approved(2)   args: approval, status ```
if(lower(coalesce($approval$, ""))="approved" OR (isnull($approval$) AND match(lower(coalesce($status$, "")), "scheduled|implementation in progress|completed")), 1, 0)

``` macro: cg_summary_index ```
changeguard_detect

``` macro: cg_session_gap ```
1800

``` macro: cg_max_log_chars ```
6000

``` macro: cg_watch_seconds ```
259200

``` macro: cg_followup_seconds ```
86400

``` macro: cg_w_rollback ```
0.6

``` macro: cg_w_followup ```
0.3

``` macro: cg_impact_threshold ```
0.35

``` macro: cg_min_confidence ```
0.6

``` macro: cg_llm(2)   args: prompt_field, task ```
`cg_llm_aitk($prompt_field$, $task$)`

``` macro: cg_llm_aitk(2)   args: prompt_field, task ```
ai prompt="{$prompt_field$}"
    | eval llm_raw=coalesce(ai_result_1, ai_result, response, result)

``` macro: cg_llm_mock(2)   args: prompt_field, task ```
eval llm_raw=case(
    "$task$"="intent", if(match(change_log, "(?i)any|temp"),
        "{\"verdict\":\"deviation\",\"confidence\":0.9,\"deviations\":[\"Session changed objects the CHG does not mention (any/temp rule)\"],\"reasons\":[\"mock: out-of-scope object in config paths\"],\"evidence_refs\":[\"change_log\"]}",
        "{\"verdict\":\"match\",\"confidence\":0.85,\"deviations\":[],\"reasons\":[\"mock: objects changed match the CHG\"],\"evidence_refs\":[\"change_log\"]}"),
    "$task$"="alt", case(alt_total>0,
        "{\"verdict\":\"authorised_elsewhere\",\"authorising_change\":\"".mvindex(alt_candidate_keys,0)."\",\"confidence\":0.8,\"reasons\":[\"mock: first candidate accepted\"],\"evidence_refs\":[\"".mvindex(alt_candidate_keys,0)."\"]}",
        is_automation=1, "{\"verdict\":\"unplanned\",\"authorising_change\":null,\"confidence\":0.7,\"reasons\":[\"mock: automation account changed config without a CHG\"],\"evidence_refs\":[]}",
        true(), "{\"verdict\":\"unplanned\",\"authorising_change\":null,\"confidence\":0.9,\"reasons\":[\"mock: no candidates\"],\"evidence_refs\":[]}"),
    "$task$"="impact", "{\"verdict\":\"plausible\",\"confidence\":0.75,\"reasons\":[\"mock: impact signal shortly after the change\"],\"evidence_refs\":[\"".coalesce(impact_incident, rollback_case, followup_case, "")."\"]}",
    "$task$"="narrative", "[mock] ".verdict." on ".session_device." by ".user.". ".mvjoin(reasons, " "),
    true(), "[mock] no answer")

``` macro: cg_parse_llm ```
rex field=llm_raw "(?s)(?<llm_json>\{.*\})"
    | spath input=llm_json path=verdict output=llm_verdict
    | spath input=llm_json path=confidence output=llm_confidence
    | spath input=llm_json path=reasons{} output=llm_reasons
    | spath input=llm_json path=evidence_refs{} output=llm_evidence_refs
    | eval llm_verdict=lower(trim(llm_verdict)), llm_confidence=tonumber(llm_confidence)

``` macro: cg_nl ```
eval nl=urldecode("%0A")

``` macro: cg_case_fields ```
fields - aql_error arango_status arango_skipped nl cg_prompt llm_raw llm_json llm_verdict llm_confidence llm_reasons llm_evidence_refs

``` macro: cg_aw_docs(3)   args: collection, key, fields ```
cgarango collection=$collection$ key=$key$ fields="$fields$" on_error=mark

``` macro: cg_aw_edges(2)   args: collection, fields ```
cgarango collection=$collection$ from=from to=to fields="$fields$" on_error=mark

``` macro: cg_aq(3)   args: query, prefix, params ```
cgaql query=$query$ prefix="$prefix$" params="$params$"

``` macro: cg_aq_all(1)   args: query ```
cgaql query=$query$ mode=all

``` macro: cg_aq_json(2)   args: query, out ```
cgaql query=$query$ mode=json out=$out$

``` macro: cg_sync_case ```
cgarango collection=cases key=case_id on_error=mark multivalue="targets,doi,related_changes,reasons,deviations,evidence_refs"
    fields="case_id,session_device,platform,device_role,targets,doi,user,user_display,itam_user,is_automation,first_seen,last_seen,event_count,status,verdict,severity,chg_number,chg_source,match_via,chg_summary,related_changes,reasons,confidence,deviations,evidence_refs,watch_until,followup_case,rollback_case,impact_score,impact_incident,evidence_summary,alerted_at,updated_at"
